{
    "version": "10.0.404",
    "description": ".NET 10 SDK, for building and running .NET apps",
    "homepage": "https://www.microsoft.com/net/",
    "license": "MIT",
    "architecture": {
        "arm64": {
            "url": "https://builds.dotnet.microsoft.com/dotnet/Sdk/10.0.404/dotnet-sdk-10.0.404-osx-arm64.tar.gz",
            "hash": "sha512:1c9a13f625d0c08f08ef5a53597bababe3d2473527e98db2199210940c69dd5fc599a39a4d7c30ebf297ca2334a81b2f64b9bf05ff99585de9af4a5d85215e96"
        },
        "x86_64": {
            "url": "https://builds.dotnet.microsoft.com/dotnet/Sdk/10.0.404/dotnet-sdk-10.0.404-osx-x64.tar.gz",
            "hash": "sha512:88ca5dac50562b619f852b1b9845f85243f00434be52d2149db18ab4dc05f527f3fca8e1dac82e87b9eeb46a98de1ba4a6d612714caf2222f37b95aeebb611b6"
        }
    },
    "env_add_path": ".",
    "env_set": {
        "DOTNET_ROOT": "$dir"
    },
    "checkver": {
        "url": "https://builds.dotnet.microsoft.com/dotnet/release-metadata/10.0/releases.json",
        "jsonpath": "$['latest-sdk']"
    },
    "autoupdate": {
        "architecture": {
            "arm64": {
                "url": "https://builds.dotnet.microsoft.com/dotnet/Sdk/$version/dotnet-sdk-$version-osx-arm64.tar.gz"
            },
            "x86_64": {
                "url": "https://builds.dotnet.microsoft.com/dotnet/Sdk/$version/dotnet-sdk-$version-osx-x64.tar.gz"
            }
        },
        "hash": {
            "url": "https://builds.dotnet.microsoft.com/dotnet/release-metadata/$majorVersion.$minorVersion/releases.json",
            "regex": "/$basename\",\\s*\"hash\":\\s*\"(?<hash>[0-9a-f]{128})\""
        }
    },
    "notes": [
        "dotnet is on PATH, and DOTNET_ROOT points at this SDK, in new terminals (spork shellenv sets both).",
        "If you added DOTNET_ROOT to ~/.zshrc yourself, you can remove that line.",
        "Global tools (dotnet tool install -g) go in ~/.dotnet/tools. To run them by name, add this to ~/.zshrc:",
        "    export PATH=\"$PATH:$HOME/.dotnet/tools\""
    ]
}
