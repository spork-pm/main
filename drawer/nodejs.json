{
    "version": "26.13.1",
    "description": "An asynchronous event driven JavaScript runtime designed to build scalable network applications",
    "homepage": "https://nodejs.org",
    "license": "MIT",
    "architecture": {
        "arm64": {
            "url": "https://nodejs.org/dist/v26.13.1/node-v26.13.1-darwin-arm64.tar.gz",
            "hash": "sha256:aec2514ea1ceb2ba52455e9ec65986f6749a06dd759e5db2a72e6889668c9735",
            "extract_dir": "node-v26.13.1-darwin-arm64"
        },
        "x86_64": {
            "url": "https://nodejs.org/dist/v26.13.1/node-v26.13.1-darwin-x64.tar.gz",
            "hash": "sha256:82bb96078a24ca50b9c9a38f2379e6be6d87171fcd400fc14c8934b3bce96e2f",
            "extract_dir": "node-v26.13.1-darwin-x64"
        }
    },
    "persist": "global",
    "env_add_path": "$persist_dir/global/bin",
    "post_install": [
        "# npm installs global packages inside its own folder, which updates replace.",
        "# Point npm's built-in config at the persisted 'global' folder instead.",
        "printf 'prefix=%s\\n' \"$(readlink \"$dir/global\")\" > \"$dir/lib/node_modules/npm/npmrc\""
    ],
    "bin": [
        "bin/node",
        "bin/npm",
        "bin/npx"
    ],
    "notes": [
        "Global packages (npm install -g) are kept in ~/.spork/persist/nodejs/global across updates,",
        "and their commands are on PATH in new terminals (spork shellenv adds them).",
        "nodejs and nodejs-lts provide the same commands; install only one of them."
    ],
    "checkver": {
        "url": "https://nodejs.org/dist/latest/SHASUMS256.txt",
        "regex": "node-v([\\d.]+)-darwin-arm64\\.tar\\.gz"
    },
    "autoupdate": {
        "architecture": {
            "arm64": {
                "url": "https://nodejs.org/dist/v$version/node-v$version-darwin-arm64.tar.gz",
                "extract_dir": "node-v$version-darwin-arm64"
            },
            "x86_64": {
                "url": "https://nodejs.org/dist/v$version/node-v$version-darwin-x64.tar.gz",
                "extract_dir": "node-v$version-darwin-x64"
            }
        },
        "hash": {
            "url": "$baseurl/SHASUMS256.txt"
        }
    }
}
