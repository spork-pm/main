{
    "version": "29.9.2",
    "description": "Docker command-line client, for a Docker engine running elsewhere (Colima, a VM or a remote host)",
    "homepage": "https://docs.docker.com/engine",
    "license": "Apache-2.0",
    "architecture": {
        "arm64": {
            "url": "https://download.docker.com/mac/static/stable/aarch64/docker-29.9.2.tgz",
            "hash": "sha256:ea8a2ce5ac31f9f5f3fb711a7a485e1e46cc7a69798a629a70306f6e6af25b7a"
        },
        "x86_64": {
            "url": "https://download.docker.com/mac/static/stable/x86_64/docker-29.9.2.tgz",
            "hash": "sha256:089c3f618df88bdef4f1257d9d604499136a1ec5168b67d194c260acad2b522f"
        }
    },
    "extract_dir": "docker",
    "bin": "docker",
    "checkver": {
        "github": "moby/moby",
        "regex": "docker-v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "arm64": {
                "url": "https://download.docker.com/mac/static/stable/aarch64/docker-$version.tgz"
            },
            "x86_64": {
                "url": "https://download.docker.com/mac/static/stable/x86_64/docker-$version.tgz"
            }
        }
    },
    "notes": [
        "This is only the docker command, not Docker Desktop or the engine.",
        "Point it at an engine with a Docker context, or with DOCKER_HOST (for example ssh://user@host)."
    ]
}
