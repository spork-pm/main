{
    "version": "29.9.3",
    "description": "Docker command-line client, for a Docker engine running elsewhere (Colima, a VM or a remote host)",
    "homepage": "https://docs.docker.com/engine",
    "license": "Apache-2.0",
    "architecture": {
        "arm64": {
            "url": "https://download.docker.com/mac/static/stable/aarch64/docker-29.9.3.tgz",
            "hash": "sha256:79145e169bca0b9571d02de8e1cd311a36e0e8fdb4599b6661a87b1bb3afbe13"
        },
        "x86_64": {
            "url": "https://download.docker.com/mac/static/stable/x86_64/docker-29.9.3.tgz",
            "hash": "sha256:f7d8f835391cd0a8c676d9a8d2547f909da6a2d029595943b0ce8d5f169abe47"
        }
    },
    "extract_dir": "docker",
    "bin": "docker",
    "checkver": {
        "github": "moby/moby",
        "regex": "docker-v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "arm64": {
                "url": "https://download.docker.com/mac/static/stable/aarch64/docker-$version.tgz"
            },
            "x86_64": {
                "url": "https://download.docker.com/mac/static/stable/x86_64/docker-$version.tgz"
            }
        }
    },
    "notes": [
        "This is only the docker command, not Docker Desktop or the engine.",
        "Point it at an engine with a Docker context, or with DOCKER_HOST (for example ssh://user@host)."
    ]
}
