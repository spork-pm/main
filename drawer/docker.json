{
    "version": "29.10.0",
    "description": "Docker command-line client, for a Docker engine running elsewhere (Colima, a VM or a remote host)",
    "homepage": "https://docs.docker.com/engine",
    "license": "Apache-2.0",
    "architecture": {
        "arm64": {
            "url": "https://download.docker.com/mac/static/stable/aarch64/docker-29.10.0.tgz",
            "hash": "sha256:84025e01f7716eb8bd1064c49a9d2b3a38547fa963983e81017c73ee8c5d540b"
        },
        "x86_64": {
            "url": "https://download.docker.com/mac/static/stable/x86_64/docker-29.10.0.tgz",
            "hash": "sha256:18fd600a2fc0bc2e62f34f66b0fd717dc2a774aa533bf3cef98011b9d37e0459"
        }
    },
    "extract_dir": "docker",
    "bin": "docker",
    "checkver": {
        "github": "moby/moby",
        "regex": "docker-v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "arm64": {
                "url": "https://download.docker.com/mac/static/stable/aarch64/docker-$version.tgz"
            },
            "x86_64": {
                "url": "https://download.docker.com/mac/static/stable/x86_64/docker-$version.tgz"
            }
        }
    },
    "notes": [
        "This is only the docker command, not Docker Desktop or the engine.",
        "Point it at an engine with a Docker context, or with DOCKER_HOST (for example ssh://user@host)."
    ]
}
