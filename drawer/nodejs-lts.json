{
    "version": "26.13.0",
    "description": "An asynchronous event driven JavaScript runtime designed to build scalable network applications (Long Term Support)",
    "homepage": "https://nodejs.org",
    "license": "MIT",
    "architecture": {
        "arm64": {
            "url": "https://nodejs.org/dist/v26.13.0/node-v26.13.0-darwin-arm64.tar.gz",
            "hash": "sha256:d38bd5e5a2ddce6bbb5ce45e46e208337da4d51fffe611e567fd32073d6439f6",
            "extract_dir": "node-v26.13.0-darwin-arm64"
        },
        "x86_64": {
            "url": "https://nodejs.org/dist/v26.13.0/node-v26.13.0-darwin-x64.tar.gz",
            "hash": "sha256:525c9b29bb0263d687de60a4cec0e2a6db876a8eb032369e5795eca71e7c358e",
            "extract_dir": "node-v26.13.0-darwin-x64"
        }
    },
    "persist": "global",
    "env_add_path": "$persist_dir/global/bin",
    "post_install": [
        "# npm installs global packages inside its own folder, which updates replace.",
        "# Point npm's built-in config at the persisted 'global' folder instead.",
        "printf 'prefix=%s\\n' \"$(readlink \"$dir/global\")\" > \"$dir/lib/node_modules/npm/npmrc\""
    ],
    "bin": [
        "bin/node",
        "bin/npm",
        "bin/npx"
    ],
    "notes": [
        "Global packages (npm install -g) are kept in ~/.spork/persist/nodejs-lts/global across updates,",
        "and their commands are on PATH in new terminals (spork shellenv adds them).",
        "nodejs-lts and nodejs provide the same commands; install only one of them."
    ],
    "checkver": {
        "url": "https://nodejs.org/dist/index.json",
        "jsonpath": "$[?(@.lts)].version",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "arm64": {
                "url": "https://nodejs.org/dist/v$version/node-v$version-darwin-arm64.tar.gz",
                "extract_dir": "node-v$version-darwin-arm64"
            },
            "x86_64": {
                "url": "https://nodejs.org/dist/v$version/node-v$version-darwin-x64.tar.gz",
                "extract_dir": "node-v$version-darwin-x64"
            }
        },
        "hash": {
            "url": "$baseurl/SHASUMS256.txt"
        }
    }
}
