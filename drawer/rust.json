{
    "version": "1.100.0",
    "description": "A language empowering everyone to build reliable and efficient software. (MSVC toolchain)",
    "homepage": "https://www.rust-lang.org",
    "license": "MIT|Apache-2.0",
    "notes": [
        "Use the rustup package instead for easier management of multiple toolchains, including beta/nightly releases.",
        "According to https://doc.rust-lang.org/book/ch01-01-installation.html#installing-rustup-on-linux-or-macos",
        "Rust needs LLVM to be installed to work and you can install it by running the following command:",
        "  xcode-select --install"
    ],
    "architecture": {
        "arm64": {
            "url": "https://static.rust-lang.org/dist/rust-1.100.0-aarch64-apple-darwin.tar.xz",
            "hash": "sha256:68ba729fe20df0f74309ef55ffbe518fc982177f327651b06112ef11e8e1de0d",
            "extract_dir": "rust-1.100.0-aarch64-apple-darwin"
        },
        "x86_64": {
            "url": "https://static.rust-lang.org/dist/rust-1.100.0-x86_64-apple-darwin.tar.xz",
            "hash": "sha256:7669d8521e663c012d3f44081b5419112f329cafd5cfbdd3b9c24c14ba9eadbb",
            "extract_dir": "rust-1.100.0-x86_64-apple-darwin"
        }
    },
    "bin": [
        "cargo/bin/cargo",
        "rustc/bin/rustc"
    ],
    "checkver": "Version ([\\d.]+)",
    "autoupdate": {
        "architecture": {
            "arm64": {
                "url": "https://static.rust-lang.org/dist/rust-$version-aarch64-apple-darwin.tar.xz",
                "extract_dir": "rust-$version-aarch64-apple-darwin"
            },
            "x86_64": {
                "url": "https://static.rust-lang.org/dist/rust-$version-x86_64-apple-darwin.tar.xz",
                "extract_dir": "rust-$version-x86_64-apple-darwin"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}